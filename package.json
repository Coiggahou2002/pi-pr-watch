{
  "name": "@coiggahou2002/pi-pr-watch",
  "version": "0.2.0",
  "description": "Track GitHub PR links from the active Pi conversation in a read-only terminal widget.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coiggahou2002/pi-pr-watch.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "github",
    "pull-request",
    "widget"
  ],
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pr-watch/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
